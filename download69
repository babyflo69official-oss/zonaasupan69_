        function stepTransition(fromEl, toEl) {
            fromEl.classList.add('step-exit');
            setTimeout(function () {
                fromEl.classList.add('js-hidden');
                fromEl.classList.remove('step-exit');
                toEl.classList.remove('js-hidden');
                toEl.classList.add('step-enter');
                setTimeout(function () { toEl.classList.remove('step-enter'); }, 300);
                setTimeout(function () {
                    var first = toEl.querySelector('button:not([disabled]), input, [tabindex="0"]');
                    if (first) first.focus();
                }, 50);
            }, 200);
        }

        /* ══ LAZY AD LOADER ══
         * Popunder & Social Bar di-load via antiblock inline script di bottom-of-body.
