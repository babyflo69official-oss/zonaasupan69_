            if (wasStep2) {
                setTimeout(function () {
                    if (canPop()) { showPopup('secondChancePopup'); incPop(); }
                }, 1500);
            }
        }

        /* ══ STEP 1 ══ */
        function startStep1() {
            var t = STEP1_T;
            D.timer1.textContent = t;
            if (ticker) clearInterval(ticker);

            ticker = setInterval(function () {
                t--;
                D.timer1.textContent = t;
                D.timer1.classList.add('timer-pulse');
                setTimeout(function () { D.timer1.classList.remove('timer-pulse'); }, 180);

                if (t <= 0) {
                    clearInterval(ticker); ticker = null;
                    D.step1Text.textContent = 'File Terverifikasi Aman!';
                    D.step1Btn.disabled = false;
                    D.step1Btn.className = 'modal-btn active btn-bounce';
                    D.step1Btn.removeAttribute('aria-busy');
                    D.step1Btn.innerHTML = '<i class="fas fa-arrow-right btn-icon" aria-hidden="true"></i>LANJUTKAN';
                    D.step1Btn.onclick = goStep2;
                }
            }, 1000);
        }

        /* ══ STEP 2 ══ */
        function goStep2() { stepTransition(D.step1, D.step2); }

        function resetStep2() {
            if (D.robotCheck) D.robotCheck.checked = false;
            D.step2Btn.disabled = true;
            D.step2Btn.className = 'modal-btn disabled';
            D.step2Btn.setAttribute('aria-disabled', 'true');
        }

        if (D.robotCheck) {
            D.robotCheck.addEventListener('change', function () {
                if (this.checked) {
                    D.step2Btn.disabled = false;
                    D.step2Btn.className = 'modal-btn active btn-bounce';
                    D.step2Btn.removeAttribute('aria-disabled');
                } else {
                    D.step2Btn.disabled = true;
                    D.step2Btn.className = 'modal-btn disabled';
                    D.step2Btn.setAttribute('aria-disabled', 'true');
                }
            });
        }

        D.step2Btn.addEventListener('click', function () {
            if (D.step2Btn.disabled) return;
            goStep3();
        });

        /* ══ STEP 3 ══ */
        function goStep3() {
            fireSL();
            stepTransition(D.step2, D.step3);
            startStep3();
        }

        function startStep3() {
            var t = STEP3_T;
            D.timer3.textContent = t;
            if (ticker) clearInterval(ticker);

            ticker = setInterval(function () {
                t--;
                D.timer3.textContent = t;
                D.timer3.classList.add('timer-pulse');
                setTimeout(function () { D.timer3.classList.remove('timer-pulse'); }, 180);

                var pct = Math.round(((STEP3_T - t) / STEP3_T) * 100);
                D.progressBar.style.width = pct + '%';
                D.progressBar.setAttribute('aria-valuenow', pct);

                if (t <= 3 && t > 0) {
                    D.step3Text.textContent = '\u26a0\ufe0f File hampir siap, jangan tutup halaman!';
                    D.step3Text.classList.add('step3-warning');
                }

                if (t <= 0) {
                    clearInterval(ticker); ticker = null;
                    D.progressBar.style.width = '100%';
                    D.progressBar.setAttribute('aria-valuenow', '100');
                    D.step3Text.textContent = 'File siap didownload!';
                    D.step3Text.classList.remove('step3-warning');
                    D.timer3.textContent = '&#x2714;';
                    D.step3Btn.disabled = false;
                    D.step3Btn.removeAttribute('aria-busy');
                    D.step3Btn.className = 'modal-btn active btn-bounce';
                    D.step3Btn.innerHTML = '<i class="fas fa-download btn-icon" aria-hidden="true"></i>OKE GAS KETUA!';
                    D.step3Btn.onclick = function () {
                        var a = document.createElement('a');
                        a.href = CONFIG.downloadUrl;
                        a.target = '_blank';
                        a.rel = 'noopener noreferrer';
                        document.body.appendChild(a);
                        a.click();
                        document.body.removeChild(a);
                        setTimeout(hideModal, 1200);
                    };
                }
            }, 1000);
        }

