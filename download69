         * menggunakan inline scripts di HTML masing-masing.
         * loadAds() dipertahankan sebagai gate trigger & titik ekstensi di masa depan.
         */
        var adsLoaded = false;
        function loadAds() {
            if (adsLoaded) return;
            adsLoaded = true;
        }

        /* ══ GATE MODAL ══ */
        function hideGate() {
            gateVisible = false;
            D.gateOverlay.classList.remove('show');
            D.gateOverlay.classList.add('hide');
            /* Disable tab focus setelah transisi selesai */
