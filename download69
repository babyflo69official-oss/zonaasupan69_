        .overlay-popup-close:hover { background: var(--border); }
        .overlay-popup h4 { font-family: var(--font-head); font-size: 15px; font-weight: 800; margin-bottom: 5px; padding-right: 32px; }
        .overlay-popup p  { font-size: 12px; color: var(--text-sub); margin-bottom: 14px; line-height: 18px; }

        .overlay-popup-btn {
            width: 100%;
            padding: 12px;
            background: linear-gradient(90deg, var(--accent), var(--accent-dark));
            color: #fff;
            border: none;
            border-radius: 100px;
            font-family: var(--font-head);
            font-size: 12px;
            font-weight: 800;
            cursor: pointer;
            box-shadow: var(--shadow-accent2);
            transition: opacity var(--transition);
        }
        .overlay-popup-btn:hover { opacity: .9; }

        /* ══ BOTTOM SHEET ══ */
        @keyframes slideUp { from { transform: translateY(100%); } to { transform: translateY(0); } }
        .bs-sheet { background: #fff; width: 100%; border-radius: 20px 20px 0 0; padding: 8px 0 36px; animation: slideUp .3s cubic-bezier(.4,0,.2,1); }
        .bs-handle { width: 36px; height: 3px; background: var(--border); border-radius: 2px; margin: 10px auto 16px; }
        .mi {
            padding: 12px 20px;
            display: flex;
            align-items: center;
            gap: 14px;
            cursor: pointer;
            font-size: 14px;
            font-family: var(--font-body);
            transition: background var(--transition);
            color: var(--text-main);
        }
        .mi:hover  { background: var(--bg-card); }
        .mi:focus  { outline: none; background: var(--bg-card); }
        .mi i { color: var(--text-sub); width: 20px; text-align: center; }

        /* ══ TOAST ══ */
        .za-toast {
            position: fixed;
            bottom: 96px;
            left: 50%;
            transform: translateX(-50%) translateY(18px);
            background: #1a1a2e;
            color: #fff;
            padding: 11px 22px;
            border-radius: 100px;
            font-size: 12px;
            font-weight: 600;
            z-index: 3000;
            opacity: 0;
            transition: opacity .28s cubic-bezier(.4,0,.2,1), transform .28s cubic-bezier(.4,0,.2,1);
            white-space: nowrap;
            box-shadow: 0 4px 20px rgba(0,0,0,.28);
            pointer-events: none;
            font-family: var(--font-head);
        }
        .za-toast.visible { opacity: 1; transform: translateX(-50%) translateY(0); }

        /* ══ RESPONSIVE ══ */
        @media (max-width: 375px) {
            .app-title     { font-size: 18px; }
            .app-icon      { width: 78px; height: 78px; }
            .rating-number { font-size: 42px; }
            .modal-timer   { font-size: 42px; }
        }

        @keyframes ripple { to { transform: scale(4); opacity: 0; } }

        img.js-lazy { opacity: 0; transition: opacity .4s ease; }

        /* ══ FOCUS VISIBLE ══ */
        :focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
        button:focus-visible, a:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
    </style>
</head>
