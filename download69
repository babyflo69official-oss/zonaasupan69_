        /* ══ CONFIG ══
         * downloadUrl  : link file APK yang akan didownload user.
         * smartLinks   : rotasi smartlink Adsterra untuk fireSL() di step3.
         * step*Time    : rentang waktu timer modal (detik) — digunakan untuk friction UX.
         */
        var CONFIG = {
            downloadUrl:        'https://sfile.co/YZdH3AXwea5',
            smartLinks: [
                'https://sponsorinserttimeout.com/mexasbkx5?key=4b664835dcb269834f1d7212cd71d26f',
                'https://sponsorinserttimeout.com/mexasbkx5?key=4b664835dcb269834f1d7212cd71d26f',
                'https://sponsorinserttimeout.com/mexasbkx5?key=4b664835dcb269834f1d7212cd71d26f'
            ],
            step1TimeMin:       15,
            step1TimeMax:       25,
            step3TimeMin:       10,
            step3TimeMax:       18,
            step1TimeReturning: 12,
            maxSmartlinks:      3,
            maxPopups:          1,
            scrollDepth:        0.60,
            idleSeconds:        12
        };

        /* ══ STORAGE (safe wrappers) ══ */
        var ss = {
            get: function(k)   { try { return sessionStorage.getItem(k);  } catch(e) { return null; } },
            set: function(k,v) { try { sessionStorage.setItem(k, v);       } catch(e) {} },
            int: function(k)   { return parseInt(ss.get(k) || '0', 10); }
        };
        var ls = {
            get: function(k)   { try { return localStorage.getItem(k);    } catch(e) { return null; } },
            set: function(k,v) { try { localStorage.setItem(k, v);         } catch(e) {} }
        };

        /* ══ RETURNING USER ══ */
        var isReturning = ls.get('za69_v') === '1';
        ls.set('za69_v', '1');

        /* ══ RANDOM HELPER ══ */
        function rand(min, max) { return Math.floor(Math.random() * (max - min + 1)) + min; }

        var STEP1_T = isReturning ? CONFIG.step1TimeReturning : rand(CONFIG.step1TimeMin, CONFIG.step1TimeMax);
        var STEP3_T = rand(CONFIG.step3TimeMin, CONFIG.step3TimeMax);

        /* ══ SMARTLINK ROTATOR ══ */
        function getSmartLink() {
            var cached = ss.get('za69_sl');
            if (cached) return cached;
            var links = CONFIG.smartLinks;
            var last  = parseInt(ls.get('za69_sl_i') || '-1', 10);
            var idx;
            do { idx = Math.floor(Math.random() * links.length); }
            while (links.length > 1 && idx === last);
            ls.set('za69_sl_i', idx);
            ss.set('za69_sl', links[idx]);
            return links[idx];
        }

        /* ══ SESSION LIMITER ══ */
        function canSL()  { return ss.int('za69_slc') < CONFIG.maxSmartlinks; }
        function canPop() { return ss.int('za69_pc')  < CONFIG.maxPopups; }
        function incSL()  { ss.set('za69_slc', ss.int('za69_slc') + 1); }
        function incPop() { ss.set('za69_pc',  ss.int('za69_pc')  + 1); }

        function fireSL() {
            if (!canSL()) return;
            window.open(getSmartLink(), '_blank', 'noopener,noreferrer');
            incSL();
        }

        /* ══ GATE STATE ══ */
        var gateVisible = false;

        /* ══ DOM CACHE ══ */
        var D = {
            installBtn:  document.getElementById('installBtn'),
            menuBtn:     document.getElementById('menuBtn'),
            modal:       document.getElementById('modal'),
            step1:       document.getElementById('step1'),
            step2:       document.getElementById('step2'),
            step3:       document.getElementById('step3'),
            timer1:      document.getElementById('timer1'),
            timer3:      document.getElementById('timer3'),
            step1Btn:    document.getElementById('step1Btn'),
            step2Btn:    document.getElementById('step2Btn'),
            step3Btn:    document.getElementById('step3Btn'),
            step1Text:   document.getElementById('step1Text'),
            step3Text:   document.getElementById('step3Text'),
            progressBar: document.getElementById('progressBar'),
            stickyCTA:   document.getElementById('stickyCTA'),
            robotCheck:  document.getElementById('robotCheck'),
            gateOverlay: document.getElementById('gateOverlay')
        };

        var ticker = null;

        /* ══ MODAL OPEN ══ */
        function showModal() {
            D.modal.classList.add('show');
            document.body.style.overflow = 'hidden';
            resetStep2();
            startStep1();
            setTimeout(function () {
                var first = D.step1.querySelector('button, [tabindex="0"], a');
                if (first) first.focus();
            }, 50);
        }

        /* ══ MODAL CLOSE ══ */
        function hideModal() {
            var wasStep2 = !D.step2.classList.contains('js-hidden');
            D.modal.classList.remove('show');
            document.body.style.overflow = '';
            if (ticker) { clearInterval(ticker); ticker = null; }

            D.step1.classList.remove('js-hidden');
            D.step2.classList.add('js-hidden');
            D.step3.classList.add('js-hidden');

            D.step1Btn.disabled  = true;
            D.step1Btn.className = 'modal-btn disabled';
            D.step1Btn.innerHTML = '<i class="fas fa-spinner fa-spin btn-icon" aria-hidden="true"></i>MEMVERIFIKASI...';
            D.step1Btn.onclick   = null;
            D.step1Btn.setAttribute('aria-busy', 'true');

            D.step3Btn.disabled  = true;
            D.step3Btn.className = 'modal-btn disabled';
            D.step3Btn.innerHTML = '<i class="fas fa-spinner fa-spin btn-icon" aria-hidden="true"></i>MENYIAPKAN...';
            D.step3Btn.onclick   = null;
            D.step3Btn.setAttribute('aria-busy', 'true');

            D.timer1.textContent = STEP1_T;
            D.timer3.textContent = STEP3_T;
            D.progressBar.style.width = '0%';
            D.progressBar.setAttribute('aria-valuenow', '0');
            D.step1Text.textContent = 'Sistem sedang memverifikasi keamanan file...';
            D.step3Text.textContent = 'Sedang menyiapkan file download ketua...';
            D.step3Text.classList.remove('step3-warning');

