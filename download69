        /* ══ MODAL ══ */
        .modal {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(10,10,20,.65);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            z-index: 1000;
            align-items: center;
            justify-content: center;
            padding: 16px;
        }
        .modal.show { display: flex; }

        .modal-content {
            background: #fff;
            border-radius: var(--radius-lg);
            padding: 22px 20px 20px;
            max-width: 390px;
            width: 100%;
            text-align: center;
            box-shadow: 0 28px 70px rgba(0,0,0,.24);
            animation: modalIn .3s cubic-bezier(.34,1.56,.64,1);
        }
        @keyframes modalIn {
            from { opacity: 0; transform: scale(.9) translateY(22px); }
            to   { opacity: 1; transform: scale(1) translateY(0); }
        }
        .modal-content.step-exit  { animation: stepOut .2s ease forwards; }
        .modal-content.step-enter { animation: stepIn .25s cubic-bezier(.4,0,.2,1) forwards; }
        @keyframes stepOut { to   { opacity: 0; transform: translateX(-28px) scale(.96); } }
        @keyframes stepIn  { from { opacity: 0; transform: translateX(28px) scale(.96); } to { opacity: 1; transform: translateX(0) scale(1); } }

        .modal-content-warn { border-top: 3px solid var(--orange); }
        .exit-modal-emoji  { font-size: 30px; margin-bottom: 8px; }

        .modal-step-label {
            font-size: 10.5px;
            color: var(--text-hint);
            text-align: left;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 5px;
        }
        .modal-title { font-family: var(--font-head); font-size: 18px; font-weight: 900; margin-bottom: 7px; color: var(--text-main); letter-spacing: -.3px; }
        .modal-text  { font-size: 12px; color: var(--text-sub); margin-bottom: 14px; line-height: 18px; }
        .modal-exit-note { background: none; border: none; font-size: 12px; color: var(--text-hint); cursor: pointer; width: 100%; padding: 6px; }
        .modal-exit-note:hover { color: var(--text-main); }

        .modal-ad {
            margin: 10px 0;
            border-radius: var(--radius-sm);
            overflow: hidden;
            min-height: 60px;
            background: var(--bg-card);
            border: 1px dashed var(--border);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        .modal-timer {
            font-family: var(--font-head);
            font-size: 50px;
            font-weight: 900;
            color: var(--accent);
            margin: 10px 0 4px;
            line-height: 1;
            transition: transform .18s;
            letter-spacing: -2px;
        }
        .modal-timer-sub { font-size: 11px; color: var(--text-hint); margin-bottom: 14px; }

        .modal-btn {
            width: 100%;
            padding: 12px 24px;
            border: none;
            border-radius: 100px;
            font-family: var(--font-head);
            font-size: 14px;
            font-weight: 800;
            cursor: pointer;
            transition: all var(--transition);
            position: relative;
            overflow: hidden;
        }
        .modal-btn.disabled { background: var(--border); color: #bbb; cursor: not-allowed; }
        .modal-btn.active   { background: linear-gradient(90deg, var(--accent), var(--accent-dark)); color: #fff; box-shadow: var(--shadow-accent); }
        .modal-btn.active:hover  { opacity: .9; }
        .modal-btn.active:active { transform: scale(.98); }
        .modal-btn.btn-bounce { animation: btnBounce .4s cubic-bezier(.34,1.56,.64,1); }
        .modal-btn-mb { margin-bottom: 10px; }
        @keyframes btnBounce { from { transform: scale(.9); } to { transform: scale(1); } }

        .modal-hint {
            font-size: 10.5px;
            color: var(--text-hint);
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 4px;
        }

        /* Step 2 checklist */
        .checklist-box {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: var(--radius-md);
            padding: 12px;
            margin: 10px 0;
            text-align: left;
        }
        .checklist-row { display: flex; align-items: center; gap: 10px; padding: 5px 0; font-size: 12px; font-weight: 600; }
        .checklist-row i.ok   { color: var(--green); }
        .checklist-row i.wait { color: var(--orange); }

        .micro-commit {
            display: flex;
            align-items: center;
            gap: 10px;
            background: #fefce8;
            border: 1px solid #fde68a;
            border-radius: var(--radius-sm);
            padding: 11px 12px;
            margin: 12px 0;
            text-align: left;
            cursor: pointer;
        }
        .micro-commit input[type="checkbox"] { width: 18px; height: 18px; accent-color: var(--accent); cursor: pointer; flex-shrink: 0; }
        .micro-commit-label { font-size: 12px; font-weight: 700; color: var(--text-main); cursor: pointer; user-select: none; }

        /* Step 3 progress */
        .progress-file-box {
            background: linear-gradient(90deg, #f0fdf4, #ecfdf5);
            border: 1px solid #bbf7d0;
            border-radius: var(--radius-md);
            padding: 12px;
            margin: 10px 0;
        }
        .progress-file-row  { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
        .progress-file-icon { color: #15803d; font-size: 20px; flex-shrink: 0; }
        .progress-file-name { font-size: 12px; font-weight: 700; color: #15803d; text-align: left; font-family: var(--font-head); }
        .progress-file-sub  { font-size: 11px; color: #22c55e; }
        .progress-bar-bg    { height: 7px; background: #bbf7d0; border-radius: 4px; overflow: hidden; }
        .progress-bar-fill  {
            height: 100%;
            background: linear-gradient(90deg, var(--accent), #22c55e);
            border-radius: 4px;
            transition: width .6s ease;
            width: 0%;
            box-shadow: 0 0 8px rgba(91,76,255,.45);
        }

        /* ══ GATE MODAL ══ */
        .gate-overlay {
            position: fixed;
            inset: 0;
            background: linear-gradient(160deg,
                rgba(10,8,20,.88) 0%,
                rgba(30,18,72,.9) 60%,
                rgba(10,8,20,.88) 100%);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            z-index: 2000;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px 16px;
            opacity: 0;
            pointer-events: none;
            transition: opacity .4s ease;
        }
        .gate-overlay.show { opacity: 1; pointer-events: auto; }
        .gate-overlay.hide { opacity: 0; pointer-events: none; transition: opacity .35s ease; }

        .gate-card {
            background: #fff;
            border-radius: var(--radius-xl);
            padding: 28px 22px 24px;
            width: 100%;
            max-width: 360px;
            text-align: center;
            box-shadow: 0 40px 90px rgba(0,0,0,.5), 0 0 0 1px rgba(255,255,255,.05);
            animation: gateIn .5s cubic-bezier(.34,1.4,.64,1) forwards;
            position: relative;
            overflow: hidden;
        }
        .gate-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 3px;
            background: linear-gradient(90deg, var(--accent-dark), var(--accent), #a78bfa, var(--accent-dark));
            background-size: 200% 100%;
            animation: gradientSlide 3s linear infinite;
        }
        @keyframes gradientSlide { 0% { background-position: 0% 50%; } 100% { background-position: 200% 50%; } }
        @keyframes gateIn {
            from { opacity: 0; transform: scale(.88) translateY(30px); }
            to   { opacity: 1; transform: scale(1)   translateY(0); }
        }
        .gate-logo  { width: 70px; height: 70px; border-radius: 20%; margin: 0 auto 14px; display: block; box-shadow: 0 6px 24px rgba(91,76,255,.4); }
        .gate-title { font-family: var(--font-head); font-size: 17px; font-weight: 900; color: var(--text-main); margin-bottom: 5px; letter-spacing: -.4px; }
        .gate-sub   { font-size: 11.5px; color: var(--text-sub); margin-bottom: 20px; line-height: 17px; }
        .gate-divider { display: flex; align-items: center; gap: 8px; margin-bottom: 14px; }
        .gate-divider-line { flex: 1; height: 1px; background: var(--border); }
        .gate-divider-text { font-size: 10px; color: var(--text-hint); font-weight: 700; white-space: nowrap; letter-spacing: .5px; font-family: var(--font-head); }

        .gate-btn-free {
            width: 100%;
            padding: 14px 20px;
            background: linear-gradient(90deg, var(--accent), var(--accent-dark));
            color: #fff;
            border: none;
            border-radius: 100px;
            font-family: var(--font-head);
            font-size: 14px;
            font-weight: 800;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            box-shadow: var(--shadow-accent);
            margin-bottom: 10px;
            transition: opacity var(--transition), transform .15s;
            animation: btnPulse 2.8s infinite;
        }
        .gate-btn-free:hover  { opacity: .9; }
        .gate-btn-free:active { transform: scale(.98); }

        .gate-btn-vip {
            width: 100%;
            padding: 12px 20px;
            background: linear-gradient(90deg, #fffbeb, #fef3c7);
            color: #92400e;
            border: 1.5px solid rgba(245,197,24,.5);
            border-radius: 100px;
            font-family: var(--font-head);
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: box-shadow var(--transition), transform .15s;
            text-decoration: none;
        }
        .gate-btn-vip:hover  { box-shadow: 0 4px 18px rgba(245,197,24,.35); }
        .gate-btn-vip:active { transform: scale(.98); }
        .gate-note { font-size: 10px; color: var(--text-hint); margin-top: 12px; line-height: 15px; }

        /* ══ QRIS MODAL ══ */
        .qris-overlay {
            position: fixed;
            inset: 0;
            background: rgba(10,10,20,.78);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            z-index: 2100;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 20px 16px;
        }
        .qris-overlay.show { display: flex; }

        .qris-card {
            background: #fff;
            border-radius: var(--radius-xl);
            padding: 22px 20px 20px;
            width: 100%;
            max-width: 360px;
            text-align: center;
            box-shadow: 0 36px 88px rgba(0,0,0,.48);
            animation: gateIn .4s cubic-bezier(.34,1.4,.64,1) forwards;
        }
        .qris-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 4px; }
        .qris-title { font-family: var(--font-head); font-size: 15px; font-weight: 800; color: var(--text-main); }
        .qris-close-btn {
            width: 28px; height: 28px;
            background: var(--bg-card);
            border: none;
            border-radius: 50%;
            cursor: pointer;
            color: var(--text-sub);
            font-size: 11px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background var(--transition);
            flex-shrink: 0;
        }
        .qris-close-btn:hover { background: var(--border); }
        .qris-sub { font-size: 11.5px; color: var(--text-sub); margin-bottom: 14px; line-height: 17px; }

        .qris-img-wrap {
            border: 2px solid var(--border);
            border-radius: var(--radius-md);
            overflow: hidden;
            margin: 0 auto 14px;
            max-width: 210px;
            box-shadow: var(--shadow-sm);
        }
        .qris-img-wrap img { width: 100%; height: auto; display: block; }

        .qris-amount-box {
            background: linear-gradient(90deg, #fefce8, #fef9c3);
            border: 1.5px solid #fde68a;
            border-radius: var(--radius-sm);
            padding: 10px 14px;
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }
        .qris-wallet-icon   { color: #92400e; font-size: 17px; }
        .qris-amount        { font-family: var(--font-head); font-size: 20px; font-weight: 900; color: #92400e; letter-spacing: -.5px; }
        .qris-amount-label  { font-size: 10.5px; color: #92400e; font-weight: 600; }

        .qris-confirm-row {
            display: flex;
            align-items: center;
            gap: 10px;
            background: #f0fdf4;
            border: 1.5px solid #bbf7d0;
            border-radius: var(--radius-sm);
            padding: 10px 12px;
            margin-bottom: 12px;
            cursor: pointer;
            text-align: left;
            transition: border-color var(--transition);
        }
        .qris-confirm-row.checked { border-color: #16a34a; background: #dcfce7; }
        .qris-confirm-row input[type="checkbox"] { width: 18px; height: 18px; accent-color: #16a34a; cursor: pointer; flex-shrink: 0; }
        .qris-confirm-label { font-size: 11.5px; font-weight: 700; color: var(--text-main); cursor: pointer; user-select: none; line-height: 16px; }

        .qris-get-btn {
            width: 100%;
            padding: 12px 20px;
            border: none;
            border-radius: 100px;
            font-family: var(--font-head);
            font-size: 14px;
            font-weight: 800;
            cursor: not-allowed;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            background: var(--border);
            color: #bbb;
            transition: all .25s;
