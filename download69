                zIndex: '2000', display: 'flex', alignItems: 'flex-end'
            });

            var sh = document.createElement('div');
            sh.className = 'bs-sheet';

            function makeItem(icon, label, handler) {
                var div = document.createElement('div');
                div.className = 'mi';
                div.setAttribute('role', 'button');
                div.setAttribute('tabindex', '0');
                div.innerHTML = '<i class="fas ' + icon + '" aria-hidden="true"></i><span>' + label + '</span>';
                div.addEventListener('click', handler);
                div.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); handler(); }
                });
                return div;
            }

            var handle = document.createElement('div');
            handle.className = 'bs-handle';
            handle.setAttribute('aria-hidden', 'true');

            sh.appendChild(handle);
            sh.appendChild(makeItem('fa-share-alt', 'Bagikan',              shareApp));
            sh.appendChild(makeItem('fa-heart',     'Tambahkan ke Wishlist', addToWishlist));
            sh.appendChild(makeItem('fa-flag',      'Tandai Tidak Pantas',   reportApp));

            ov.appendChild(sh);
            document.body.appendChild(ov);
            ov.addEventListener('click', function (e) { if (e.target === ov) closeMenu(); });

            setTimeout(function () { var first = sh.querySelector('.mi'); if (first) first.focus(); }, 50);
        }

        function closeMenu() { var o = document.querySelector('[data-menu]'); if (o) o.remove(); }

        function shareApp() {
            closeMenu();
            if (navigator.share) {
                navigator.share({
                    title: 'Zona Asupan 69',
                    text: 'Zonanya Asupan dewasa terlengkap yang mampu penuhi segala kebutuhan asupan dewasa kamu secara Aman, VIP dan Eksklusif yang tanpa batas!',
                    url: location.href
                }).catch(function(){});
            } else if (navigator.clipboard) {
                navigator.clipboard.writeText(location.href)
                    .then(function () { showToast('Link disalin!'); })
                    .catch(function(){});
            } else {
                showToast('Copy link: ' + location.href);
            }
        }

        function addToWishlist() { closeMenu(); showToast('Ditambahkan ke wishlist \u2764\ufe0f'); }
        function reportApp()     { closeMenu(); showToast('Terima kasih atas laporannya'); }

        /* ══ KEYBOARD GLOBAL (Escape) ══ */
        document.addEventListener('keydown', function (e) {
            if (e.key !== 'Escape') return;
            if (qrisOverlay.classList.contains('show')) { hideQrisModal(); return; }
            if (D.modal.classList.contains('show'))     { hideModal();     return; }
            if (document.querySelector('[data-menu]'))  { closeMenu();     return; }
            document.getElementById('exitIntentModal').classList.remove('show');
        });

        /* ══ INIT ══ */
        function init() {
            /* Gate modal — tampilkan setelah 100ms */
            setTimeout(function () {
                gateVisible = true;
                D.gateOverlay.classList.add('show');
                setTimeout(function () {
                    var first = D.gateOverlay.querySelector('button');
                    if (first) first.focus();
                }, 150);
            }, 100);

            D.installBtn.addEventListener('click', function (e) {
                addRipple(e, D.installBtn);
                setTimeout(triggerInstall, 120);
            });

            D.menuBtn.addEventListener('click', showMenu);
            document.getElementById('stickyBtn').addEventListener('click', triggerInstall);

            D.modal.addEventListener('click', function (e) { if (e.target === D.modal) hideModal(); });
            document.getElementById('exitIntentModal').addEventListener('click', function (e) {
                if (e.target === this) closeExitIntent();
            });

            setupAccordions();
            setupHelpfulBtns();
            initCarousel();
            initRatingBars();
            initLazyLoad();
            resetIdle();

            /* Aktifkan sticky CTA setelah gate ditutup */
            D.gateOverlay.addEventListener('transitionend', function onEnd() {
                if (!gateVisible) {
                    clearTimeout(stickyCTATimer);
                    setTimeout(function () { D.stickyCTA.classList.add('visible'); }, 2000);
                    D.gateOverlay.removeEventListener('transitionend', onEnd);
                }
            });
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', init);
        } else {
            init();
        }

 
    })();
 
</script>
