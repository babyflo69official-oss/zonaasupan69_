        /* ══ QRIS MODAL ══ */
        var qrisOverlay    = document.getElementById('qrisOverlay');
        var qrisPaidCheck  = document.getElementById('qrisPaidCheck');
        var qrisGetBtn     = document.getElementById('qrisGetBtn');
        var qrisConfirmRow = document.getElementById('qrisConfirmRow');
