        var dropdownBtn = document.getElementById('dropdownBtn');
        if (dropdownBtn) dropdownBtn.addEventListener('click', showMenu);

        /* ══ ACCORDION ══ */
        function setupAccordions() {
            var triggers = document.querySelectorAll('.section-header[aria-controls]');
            triggers.forEach(function (trigger) {
                var contentId = trigger.getAttribute('aria-controls');
                var iconId    = trigger.id.replace('-trigger', '-icon');
                var content   = document.getElementById(contentId);
                var icon      = document.getElementById(iconId);
                if (!content) return;

                function toggle() {
                    var expanded = trigger.getAttribute('aria-expanded') === 'true';
                    trigger.setAttribute('aria-expanded', String(!expanded));
                    content.classList.toggle('expanded', !expanded);
                    if (icon) icon.className = 'fas fa-chevron-right expand-icon' + (!expanded ? ' rotated' : '');
                }

                trigger.addEventListener('click', toggle);
                trigger.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggle(); }
                });
            });
        }

        /* ══ HELPFUL BUTTONS ══ */
        function setupHelpfulBtns() {
            document.addEventListener('click', function (e) {
                var btn = e.target.closest('.helpful-btn');
                if (!btn) return;
                var parent  = btn.closest('.review-actions');
                if (!parent) return;
                var buttons = parent.querySelectorAll('.helpful-btn');
                var was = btn.classList.contains('active');
                buttons.forEach(function (b) { b.classList.remove('active'); });
                if (!was) { btn.classList.add('active'); showToast('Terima kasih atas masukan Anda!'); }
