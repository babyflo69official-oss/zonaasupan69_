            box-shadow: var(--shadow-accent);
            animation: stickyCTAPulse 3s infinite 2s;
            transition: opacity var(--transition);
        }
        .sticky-cta-btn:hover  { opacity: .9; }
        .sticky-cta-btn:active { transform: scale(.98); }
        @keyframes stickyCTAPulse {
            0%, 100% { box-shadow: 0 8px 32px rgba(91,76,255,.38); }
            50%       { box-shadow: 0 8px 52px rgba(91,76,255,.6); }
