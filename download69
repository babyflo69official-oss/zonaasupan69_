        .qris-get-btn.unlocked:hover  { opacity: .9; }
        .qris-get-btn.unlocked:active { transform: scale(.98); }

        /* ══ OVERLAY POPUPS ══ */
        .overlay-popup {
            position: fixed;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%) translateY(110%);
            width: 100%;
            max-width: 480px;
            background: #fff;
            border-radius: var(--radius-lg) var(--radius-lg) 0 0;
            padding: 20px 18px 36px;
            box-shadow: 0 -8px 52px rgba(0,0,0,.16);
            z-index: 950;
            transition: transform .4s cubic-bezier(.34,1.2,.64,1);
        }
        .overlay-popup.show { transform: translateX(-50%) translateY(0); }

        .overlay-popup-close {
            position: absolute;
            top: 12px; right: 16px;
            background: var(--bg-card);
            border: none;
            cursor: pointer;
            color: var(--text-sub);
            font-size: 12px;
            width: 28px; height: 28px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background var(--transition);
