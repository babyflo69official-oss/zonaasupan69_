        /* ══ SCROLL TRIGGER ══ */
        var scrollShown = false;
        function checkScroll() {
            if (scrollShown) return;
            var depth = (window.scrollY + window.innerHeight) / document.documentElement.scrollHeight;
            if (depth >= CONFIG.scrollDepth) {
                scrollShown = true;
                D.stickyCTA.classList.add('visible');
                var anyPopupOpen = document.querySelector('.overlay-popup.show');
                if (!anyPopupOpen && canPop()) { showPopup('scrollCTAPopup'); incPop(); }
            }
        }

        /* ══ IDLE TRIGGER ══ */
        var idleTimer, idleShown = false;
        function resetIdle() {
            clearTimeout(idleTimer);
            if (idleShown) return;
            idleTimer = setTimeout(function () {
                var anyPopupOpen = document.querySelector('.overlay-popup.show');
                if (!D.modal.classList.contains('show') && !gateVisible && !anyPopupOpen && canPop() && !idleShown) {
                    idleShown = true;
                    showPopup('idlePopup');
                    incPop();
                }
            }, CONFIG.idleSeconds * 1000);
        }

        ['mousemove','scroll','keydown','touchstart','click'].forEach(function (ev) {
            document.addEventListener(ev, resetIdle, { passive: true });
        });

        /* ══ STICKY CTA fallback ══ */
        var stickyCTATimer = setTimeout(function () { D.stickyCTA.classList.add('visible'); }, 5000);

        /* ══ EXIT INTENT — DESKTOP ══ */
        var exitShown = false;
