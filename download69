        /* ══ RIPPLE EFFECT ══ */
        function addRipple(e, el) {
            var r    = document.createElement('span');
            var rect = el.getBoundingClientRect();
            var sz   = Math.max(rect.width, rect.height);
            Object.assign(r.style, {
                position: 'absolute', width: sz + 'px', height: sz + 'px',
                left: (e.clientX - rect.left - sz / 2) + 'px',
                top:  (e.clientY - rect.top  - sz / 2) + 'px',
                background: 'rgba(255,255,255,.38)',
                borderRadius: '50%', transform: 'scale(0)',
                animation: 'ripple .55s ease-out forwards',
                pointerEvents: 'none'
            });
            el.appendChild(r);
            setTimeout(function () { r.remove(); }, 600);
        }

        /* ══ DRAG CAROUSEL ══ */
        function initCarousel() {
            var c = document.getElementById('screenshotsCarousel');
            if (!c) return;
            var down = false, startX, sl;
            c.addEventListener('mousedown',  function (e) { down = true; startX = e.pageX - c.offsetLeft; sl = c.scrollLeft; });
            c.addEventListener('mouseleave', function ()  { down = false; });
            c.addEventListener('mouseup',    function ()  { down = false; });
            c.addEventListener('mousemove',  function (e) {
                if (!down) return;
                e.preventDefault();
                c.scrollLeft = sl - (e.pageX - c.offsetLeft - startX) * 1.5;
            });
        }

        /* ══ RATING BARS ANIMATION ══ */
        function initRatingBars() {
            if (!window.IntersectionObserver) return;
            var obs = new IntersectionObserver(function (entries) {
                entries.forEach(function (entry) {
                    if (!entry.isIntersecting) return;
                    entry.target.querySelectorAll('.rating-bar-fill').forEach(function (bar, i) {
                        var w = bar.style.width; bar.style.width = '0%';
                        setTimeout(function () { bar.style.width = w; }, i * 80 + 100);
                    });
                    obs.unobserve(entry.target);
                });
            }, { threshold: 0.4 });
            var sec = document.querySelector('.ratings-section');
            if (sec) obs.observe(sec);
        }

        /* ══ LAZY LOAD ══ */
        function initLazyLoad() {
            var imgs = document.querySelectorAll('img[loading="lazy"]');
            if (!window.IntersectionObserver) {
                imgs.forEach(function (img) { img.style.opacity = '1'; });
                return;
            }
            var obs = new IntersectionObserver(function (entries, o) {
                entries.forEach(function (entry) {
                    if (!entry.isIntersecting) return;
                    var img = entry.target;
                    function reveal() { img.classList.remove('js-lazy'); img.style.opacity = '1'; }
                    if (img.complete) { reveal(); }
                    else {
                        img.addEventListener('load',  reveal, { once: true });
                        img.addEventListener('error', reveal, { once: true });
                    }
                    o.unobserve(img);
                });
            }, { rootMargin: '120px' });
            imgs.forEach(function (img) { img.classList.add('js-lazy'); obs.observe(img); });
        }

        /* ══ BOTTOM SHEET MENU ══ */
        function showMenu() {
            var ov = document.createElement('div');
